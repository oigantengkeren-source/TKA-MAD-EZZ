# ==============================================================
# TKA Made Easy — Konfigurasi Lingkungan (.env)
# Salin file ini menjadi .env jika ingin menambahkan API key
# ==============================================================

# [Opsional] Aktifkan AI Assistant dengan Google Gemini (Gratis)
# Dapatkan di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [Opsional] Atau gunakan Groq (LLaMA 3) (Gratis)
# Dapatkan di: https://console.groq.com/
GROQ_API_KEY=

# [Opsional] Database Eksternal (PostgreSQL / Supabase / Neon)
# Jika dikosongkan, backend otomatis menggunakan SQLite lokal (tka.db)
# yang tersimpan aman di komputermu tanpa batas waktu / tanpa suspend.
DATABASE_URL=
